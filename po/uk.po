msgid "The file cannot be read."
msgstr "Не вдається прочитати файл."

msgid "This is not a picture the app can open."
msgstr "Це не малюнок, який застосунок може відкрити."

msgid "The picture is bigger than 10000 pixels in width or height."
msgstr "Малюнок більший за 10000 пікселів завширшки або заввишки."

msgid "Open Picture"
msgstr "Відкрити малюнок"

msgid "Draw with the foreground color. The secondary button uses the background color."
msgstr "Малює основним кольором. Додаткова кнопка малює кольором тла."

msgid "Paint with the foreground color. The secondary button uses the background color."
msgstr "Фарбує основним кольором. Додаткова кнопка фарбує кольором тла."

msgid "Spray with the foreground color. The secondary button uses the background color."
msgstr "Розпилює основний колір. Додаткова кнопка розпилює колір тла."

msgid "Erase to transparency. The secondary button erases only the foreground color."
msgstr "Стирає до прозорості. Додаткова кнопка стирає лише основний колір."

msgid "Erase to the background color. The secondary button changes only the foreground color."
msgstr "Стирає до кольору тла. Додаткова кнопка змінює лише основний колір."

msgid "Changes the magnification."
msgstr "Змінює збільшення."

msgid "Draws a straight line with the selected line width."
msgstr "Малює пряму лінію вибраної товщини."

msgid "Draws a rectangle with the selected fill style."
msgstr "Малює прямокутник вибраним стилем заливки."

msgid "Draws a rounded rectangle with the selected fill style."
msgstr "Малює заокруглений прямокутник вибраним стилем заливки."

msgid "Draws an ellipse with the selected fill style."
msgstr "Малює еліпс вибраним стилем заливки."

msgid "Draws a curved line: drag a line, then drag points of it to bend it. A click away from it finishes it."
msgstr "Малює криву лінію: проведіть лінію, потім перетягуйте її точки, щоб вигнути. Клацання поруч завершує її."

msgid "Draws a polygon with the selected fill style."
msgstr "Малює багатокутник вибраним стилем заливки."

msgid "Selects a rectangular part of the picture to move, copy, or edit."
msgstr "Виділяє прямокутну частину малюнка, щоб перемістити, скопіювати чи змінити її."

msgid "Selects a free-form part of the picture to move, copy, or edit."
msgstr "Виділяє довільну частину малюнка, щоб перемістити, скопіювати чи змінити її."

msgid "Fades the drawing color to transparent along a drag. A click or Enter applies it, Esc cancels it."
msgstr "Плавно переводить колір у прозорий уздовж перетягування. Клацання або Enter застосовує, Esc скасовує."

msgid "Picks up a color from the picture for drawing."
msgstr "Бере колір із малюнка для малювання."

msgid "Fills an area with the current drawing color."
msgstr "Заливає ділянку поточним кольором."

msgid "Inserts text into the picture."
msgstr "Вставляє текст у малюнок."

msgid "Drag to pan. Ctrl+wheel zooms."
msgstr "Перетягуйте для зсуву. Ctrl+коліщатко змінює масштаб."

msgid "Zoom"
msgstr "Масштаб"

msgid "Zoom Out (Ctrl+-)"
msgstr "Зменшити (Ctrl+-)"

msgid "Zoom In (Ctrl+=)"
msgstr "Збільшити (Ctrl+=)"

