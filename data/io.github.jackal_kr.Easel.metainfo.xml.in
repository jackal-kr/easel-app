<component type="desktop-application">
  <id>io.github.jackal_kr.Easel</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Easel</name>
  <summary>Draw and touch up pictures</summary>
  <description>
    <p>Easel is a simple drawing program for quick pictures and touch-ups, in the style of Paint in Windows XP.</p>
    <p>It has the classic tools, exact pixels, undo, selections you can move and stretch, text boxes and printing.</p>
  </description>
  <launchable type="desktop-id">io.github.jackal_kr.Easel.desktop</launchable>
  <developer id="io.github.jackal_kr">
    <name translate="no">JOD</name>
  </developer>
  <url type="homepage">https://github.com/jackal-kr/easel-app</url>
  <url type="bugtracker">https://github.com/jackal-kr/easel-app/issues</url>
  <content_rating type="oars-1.1"/>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/jackal-kr/easel-app/v0.1.0-beta.1/data/screenshots/main.png</image>
    </screenshot>
  </screenshots>
  <provides>
    <binary>easel</binary>
  </provides>
  <releases>
    <release version="1.0.2" date="2026-11-13" type="stable"/>
    <release version="1.0.1" date="2026-11-13" type="stable"/>
    <release version="1.0.0" date="2026-11-12" type="stable"/>
    <release version="0.1.0~beta.1" date="2026-11-11" type="development"/>
    <release version="0.1.0~alpha.1" date="2026-11-05" type="development"/>
  </releases>
