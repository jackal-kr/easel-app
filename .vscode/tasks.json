{
  "version": "2.0.0",
  "tasks": [
    { "label": "Spec: status", "type": "shell", "command": "tools/spec.sh status", "problemMatcher": [] },
    { "label": "Spec: lint", "type": "shell", "command": "tools/spec.sh lint", "problemMatcher": [] },
    {
      "label": "Spec: new",
      "type": "shell",
      "command": "tools/spec.sh new ${input:number} ${input:slug}",
      "problemMatcher": []
    }
  ],
  "inputs": [
    { "id": "number", "type": "promptString", "description": "Feature number from docs/specs/INDEX.md (4 digits)" },
    { "id": "slug", "type": "promptString", "description": "Short kebab-case slug" }
  ]
}
