{
  "version": "2.0.0",
  "tasks": [
    { "label": "Build", "type": "shell", "command": "test -d build || meson setup build; ninja -C build", "group": { "kind": "build", "isDefault": true }, "problemMatcher": ["$gcc"] },
    { "label": "Test", "type": "shell", "command": "tools/isolated.sh meson test -C build --print-errorlogs", "group": { "kind": "test", "isDefault": true }, "problemMatcher": [] },
    { "label": "Package: build Flatpak", "type": "shell", "command": "tools/package.sh flatpak", "problemMatcher": [] },
    { "label": "Package: build deb", "type": "shell", "command": "tools/package.sh deb", "problemMatcher": [] },
    { "label": "Package: build all", "type": "shell", "command": "tools/package.sh all", "problemMatcher": [] },
    { "label": "Package: install Flatpak", "type": "shell", "command": "tools/package.sh install-flatpak", "problemMatcher": [] },
    { "label": "Package: install deb", "type": "shell", "command": "tools/package.sh install-deb", "problemMatcher": [] },
    { "label": "Spec: status", "type": "shell", "command": "tools/spec.sh status", "problemMatcher": [] },
    { "label": "Spec: lint", "type": "shell", "command": "tools/spec.sh lint", "problemMatcher": [] },
    {
      "label": "Spec: new",
      "type": "shell",
      "command": "tools/spec.sh new ${input:number} ${input:slug}",
      "problemMatcher": []
    },
    { "label": "Git: commit", "type": "shell", "command": "git status --short && git add -A && git commit -m \"$SUBJECT\" -m \"$WHY\"", "options": { "env": { "SUBJECT": "${input:commitSubject}", "WHY": "${input:commitWhy}" } }, "problemMatcher": [] },
    { "label": "Git: push", "type": "shell", "command": "git push", "problemMatcher": [] },
    { "label": "Release: build and publish", "type": "shell", "command": "tools/release.sh", "problemMatcher": [] }
  ],
  "inputs": [
    { "id": "number", "type": "promptString", "description": "Feature number from docs/specs/INDEX.md (4 digits)" },
    { "id": "slug", "type": "promptString", "description": "Short kebab-case slug" },
    { "id": "commitSubject", "type": "promptString", "description": "Commit subject, imperative" },
    { "id": "commitWhy", "type": "promptString", "description": "Commit body: why the change" }
  ]
}
